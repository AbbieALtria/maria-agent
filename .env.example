# Copy to .env for local dev. On Railway, set these as service variables — never commit real values.
# See docs/outbound/02-ARCHITECTURE.md §6.

# --- api / worker-jobs ---
DATABASE_URL=postgresql+asyncpg://maria:maria@localhost:5432/maria
# Optional: tests create/drop "<db>_test" on the same server unless this is set.
# TEST_DATABASE_URL=postgresql+asyncpg://maria:maria@localhost:5432/maria_test
REDIS_URL=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# development | production. Outside development the API refuses to start without a real JWT_SECRET.
ENV=development

ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=maria-outbound

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Shared with voice-worker; required header X-Internal-Secret on /internal/*
INTERNAL_API_SECRET=

EMAIL_PROVIDER=resend
RESEND_API_KEY=
FROM_EMAIL=

SMS_PROVIDER=telnyx
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=

OMNICX_BASE_URL=
OMNICX_API_KEY=
OPENLEADS_BASE_URL=
OPENLEADS_API_KEY=

MAX_CONCURRENT_CALLS=10
DEFAULT_RECORDING_RETENTION_DAYS=180
# Local dev only. On Railway: a random 32+ char value (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))").
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=720

# Seed script (scripts/seed.ps1): first admin login. Choose your own password.
SEED_ADMIN_EMAIL=admin@altria.local
SEED_ADMIN_PASSWORD=

# --- voice-worker (Phase 2) ---
# API_BASE_URL=http://localhost:8000
# (also LIVEKIT_*, ANTHROPIC/DEEPGRAM/ELEVENLABS keys, INTERNAL_API_SECRET, S3_*)

# --- web: see apps/web/.env.example (VITE_API_BASE_URL) ---
